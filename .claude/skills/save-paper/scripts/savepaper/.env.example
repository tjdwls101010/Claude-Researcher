# Copy to .env in this directory (gitignored). Read by save_paper.py for figure alt text.
# Priority: environment variable > this file > <project root>/.env
OPENROUTER_API_KEY=
# Vision model. Default when unset: openai/gpt-5.6-luna
OPENROUTER_MODEL=
# none | low | medium | high | xhigh | max. Default: high (measured <= 4,660 reasoning tokens per figure)
OPENROUTER_REASONING_EFFORT=
# Credit reserved per request. Default: 16000. effort=max needs 32000+ (measured avg 12,452 reasoning tokens)
OPENROUTER_MAX_TOKENS=
