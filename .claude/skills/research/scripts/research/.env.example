# Copy to .env in this directory (gitignored). Read by research.py for the codex lane.
# Priority: environment variable > this file > <project root>/.env
# Codex model for `review request --lane codex` and ideate lanes. Default gpt-6-astra. The Claude model is pinned in .claude/agents/critic.md
CODEX_MODEL=
# Reasoning effort passed as model_reasoning_effort (low | medium | high | ...). Default: the model's own default
CODEX_EFFORT=
